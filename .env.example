# Copy to .env next to compose.yaml to override defaults.
# Host ports: UI + REST (tunnel target) and agent (MCP/hooks/uploads, LAN only).
HEPH_UI_PORT=8080
HEPH_AGENT_PORT=8081
# Agent URL as Claude Code machines reach it (shown on Settings > Connect Claude Code
# and used for upload links), e.g. http://192.168.1.10:8081. Empty: derived per request.
HEPH_PUBLIC_AGENT_URL=
TZ=Europe/Rome
# Image tag to pull from ghcr.io/undermix96/heph: latest, or a release version like 2026.11.24-b1.
HEPH_TAG=latest
