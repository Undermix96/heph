# Copy to .env next to compose.yaml to override defaults.
# Host ports: UI + REST (tunnel target) and agent (MCP/hooks/uploads, LAN only).
HEPH_UI_PORT=8080
HEPH_AGENT_PORT=8081
TZ=Europe/Rome
# Image tag to pull from ghcr.io/undermix96/heph (latest, a short commit SHA like sha-cde56b2, or a release tag).
HEPH_TAG=latest
