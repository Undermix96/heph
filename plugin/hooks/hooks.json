{
  "description": "FEASIBILITY SPIKE (phase 5.0): every hook reports to the local echo server on 127.0.0.1:18399.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/spike.sh\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/spike.sh", "stop"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:18399/hooks/v1/pre-tool-use",
            "timeout": 3,
            "headers": { "Authorization": "Bearer $CLAUDE_PLUGIN_OPTION_HEPH_TOKEN" },
            "allowedEnvVars": ["CLAUDE_PLUGIN_OPTION_HEPH_TOKEN"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:18399/hooks/v1/post-tool-use",
            "timeout": 3,
            "headers": { "Authorization": "Bearer ${CLAUDE_PLUGIN_OPTION_HEPH_TOKEN}" },
            "allowedEnvVars": ["CLAUDE_PLUGIN_OPTION_HEPH_TOKEN"]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:18399/hooks/v1/session-end",
            "timeout": 2,
            "headers": { "Authorization": "Bearer $CLAUDE_PLUGIN_OPTION_HEPH_TOKEN" },
            "allowedEnvVars": ["CLAUDE_PLUGIN_OPTION_HEPH_TOKEN"]
          }
        ]
      }
    ]
  }
}
